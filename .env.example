# Optional development-only admin mock-auth controls for the Command Center.
# Do not use these as production authentication. Replace with real auth before real data.
ADMIN_DEV_AUTH_ENABLED=true
ADMIN_DEV_USER_NAME="Maya Rivera"
ADMIN_DEV_USER_ROLE=owner

# Optional server-only AI campaign generation.
# Never expose this value through a NEXT_PUBLIC_ variable.
OPENAI_API_KEY=

# Defaults to gpt-5.6 when omitted. Override only with a model available to the account.
OPENAI_CAMPAIGN_MODEL=gpt-5.6

# When false or omitted, provider failures fall back to deterministic fixture copy.
# Set true only when a failed AI request should block generation entirely.
OPENAI_CAMPAIGN_STRICT=false
