# Development-only mock admin controls.
# Leave ADMIN_DEV_AUTH_ENABLED=false in Production.
ADMIN_DEV_AUTH_ENABLED=true
ADMIN_DEV_USER_NAME="Maya Rivera"
ADMIN_DEV_USER_ROLE=owner

# Production Growth OS authentication.
# ADMIN_AUTH_SECRET must be at least 32 random characters and must remain server-only.
# Owner and manager passwords must each be at least 12 characters.
ADMIN_AUTH_SECRET=
ADMIN_OWNER_NAME="Club Bahia Owner"
ADMIN_OWNER_PASSWORD=
ADMIN_MANAGER_NAME="Club Bahia Manager"
ADMIN_MANAGER_PASSWORD=

# Optional server-only AI campaign generation.
# Never expose this value through a NEXT_PUBLIC_ variable.
OPENAI_API_KEY=

# Override only with a model available to the account.
OPENAI_CAMPAIGN_MODEL=gpt-5.6

# When false or omitted, provider failures fall back to deterministic fixture copy.
# Set true only when a failed AI request should block generation entirely.
OPENAI_CAMPAIGN_STRICT=false

# Shared event media, public event snapshots, and encrypted reservation storage.
# Connecting a Vercel Blob store normally creates this token.
# Keep it server-only and never prefix it with NEXT_PUBLIC_.
BLOB_READ_WRITE_TOKEN=

# Dedicated encryption secret for shared Growth OS events, campaigns, post assignments,
# and publishing records. Recommended: at least 32 random characters.
# When omitted, RESERVATION_DATA_SECRET and then ADMIN_AUTH_SECRET are used as fallbacks.
GROWTH_OS_DATA_SECRET=

# Temporary media/reservation owner gate retained during the migration to full admin sessions.
# Use a long unique value and never share it publicly.
ADMIN_ASSET_UPLOAD_SECRET=

# Separate encryption secret for guest reservation records.
# Recommended: generate at least 32 random bytes and store only as a server secret.
# When omitted, ADMIN_ASSET_UPLOAD_SECRET is used as a temporary fallback.
RESERVATION_DATA_SECRET=

# Live website event publishing is off by default.
# Preview snapshots can still be generated for review in Vercel Preview environments.
PUBLIC_EVENT_PUBLISH_ENABLED=false

# Controlled social publishing switches remain off until the real Club Bahia account
# and exact provider workflow have been reviewed successfully.
META_PUBLISH_ENABLED=false
META_REELS_PROOF_ENABLED=false
TIKTOK_CONTENT_POSTING_ENABLED=false

# Protected recurring scheduler authorization. Use one long random value.
# CRON_SECRET is the preferred name; PUBLISHING_CRON_SECRET remains a migration alias.
CRON_SECRET=
PUBLISHING_CRON_SECRET=

# Final public website origin used when generating social, QR, and campaign links.
# Replace this example with the verified production domain. Never use a Preview URL.
NEXT_PUBLIC_SITE_URL=https://club-bahia.example

# Optional public Vercel Blob URLs for the approved Azucar LA marquee photos.
# Night image is the resident-program hero; day image is the supporting heritage image.
# Until these are set, the site uses existing Club Bahia venue photography.
NEXT_PUBLIC_AZUCAR_LA_NIGHT_IMAGE_URL=
NEXT_PUBLIC_AZUCAR_LA_DAY_IMAGE_URL=
